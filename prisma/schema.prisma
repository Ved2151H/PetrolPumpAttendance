generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
}

model Firm {
  id             String     @id @default(cuid())
  name           String
  companyAddress String?
  companyEmail   String?
  supportContact String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  workers        Worker[]
  auditLogs      AuditLog[]
  notes          Note[]
  invoices       Invoice[]
}

model Admin {
  id          String     @id @default(cuid())
  adminNumber Int        @default(autoincrement())
  email       String     @unique
  password    String
  name        String
  role        Role       @default(ADMIN)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  notes       Note[]
  auditLogs   AuditLog[]
}

model Worker {
  id          String        @id @default(cuid())
  firmId      String        @default("narmata")
  firm        Firm          @relation(fields: [firmId], references: [id])
  name        String
  phone       String?
  joiningDate DateTime      @default(now())
  deletedAt   DateTime?
  isArchived  Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  attendances Attendance[]
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

model Attendance {
  id        String           @id @default(cuid())
  workerId  String
  date      DateTime         // Store as Date without time component or standard midnight UTC
  status    AttendanceStatus
  timeIn    String?
  timeOut   String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  worker    Worker           @relation(fields: [workerId], references: [id])

  @@unique([workerId, date])
}

model AuditLog {
  id          String   @id @default(cuid())
  firmId      String   @default("narmata")
  firm        Firm     @relation(fields: [firmId], references: [id])
  adminId     String?
  adminNumber Int?
  adminName   String?
  entityType  String?
  entityId    String?
  action      String
  details     String?
  createdAt   DateTime @default(now())
  admin       Admin?   @relation(fields: [adminId], references: [id])
}

model Note {
  id        String    @id @default(cuid())
  firmId    String    @default("narmata")
  firm      Firm      @relation(fields: [firmId], references: [id])
  title     String
  content   String
  noteDate  DateTime
  adminId   String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  admin     Admin     @relation(fields: [adminId], references: [id])
}

model Invoice {
  id             String        @id @default(cuid())
  invoiceNumber  String
  customerName   String
  customerPhone  String?
  customerAddress String?
  date           DateTime      @default(now())
  subtotal       Decimal       @db.Decimal(12, 2)
  totalAmount    Decimal       @db.Decimal(12, 2)
  firmId         String
  firm           Firm          @relation(fields: [firmId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  items          InvoiceItem[]

  @@unique([firmId, invoiceNumber])
  @@index([firmId])
  @@index([invoiceNumber])
  @@index([date])
}

model InvoiceItem {
  id           String   @id @default(cuid())
  invoiceId    String
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  materialName String
  quantity     Float
  unit         String
  price        Decimal  @db.Decimal(12, 2)
  total        Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([invoiceId])
}
